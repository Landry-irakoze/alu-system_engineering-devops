#!/usr/bin/env bash
# Run nginx as the nginx user and listen on port 8080
chmod 644 /etc/nginx/nginx.conf
sed -Ei 's/^\s*#?\s*user\s+[^;]*/user nginx/' /etc/nginx/nginx.conf
sed -Ei 's/(listen (\[::\]:)?)80\b/\18080/g' /etc/nginx/sites-enabled/default
pkill apache2
sudo -u nginx service nginx restart
